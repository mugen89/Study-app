<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows Forms user interface. Produces StudyApp.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StudyApp</AssemblyName>
    <RootNamespace>StudyApp.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);WFO1000;WFO5001;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudyApp.Domain\StudyApp.Domain.csproj" />
    <ProjectReference Include="..\StudyApp.Data\StudyApp.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="StudyApp.app.ico" />
  </ItemGroup>

</Project>
