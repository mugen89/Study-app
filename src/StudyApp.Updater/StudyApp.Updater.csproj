<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tiny helper that replaces the app files after StudyApp.exe has closed, then starts the new version.
    Targets .NET Framework 4.7.2, which is part of every supported Windows 10/11, so it needs no runtime of its own.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>StudyApp.Updater</AssemblyName>
    <RootNamespace>StudyApp.Updater</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ApplicationIcon>..\StudyApp.App\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>true</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
